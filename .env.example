# Required
NETWORK=saigon # or ronin
DATADIR=./datadir
OP_NODE_L1_ETH_RPC=
OP_NODE_L1_BEACON=
OP_NODE_P2P_SYNC_ONLYREQTOSTATIC=true
UPDATE_BEDROCK_BLOCK=true

# For the RETH_SEQUENCER_URL make sure to add an API key for production usage. Follow the steps here: https://docs.conduit.xyz/rpc-nodes/getting-started/get-api-key
# Saigon defaults
RETH_SEQUENCER_URL=https://rpc-saigon-testnet-cc58e966ql.t.conduit.xyz
OP_NODE_P2P_STATIC=/ip4/34.187.134.72/tcp/9222/p2p/16Uiu2HAmFyGhL6G7CRgc77zmEeWAdBJA2vFsY9LSYzJQfnCrpWUW

# Ronin defaults
# RETH_SEQUENCER_URL=https://rpc-ronin-mainnet-bfz9fadqzl.t.conduit.xyz
# OP_NODE_P2P_STATIC=/ip4/34.11.218.92/tcp/9222/p2p/16Uiu2HAm2wpj12oJjJJS3EwkpCMMJBw5FvbKivQLLC9TzMmh456G


# EigenDA defaults
EIGENDA_PROXY_VERSION=2.7.0
EIGENDA_PROXY_PORT=3100
OP_NODE_ALTDA_DA_SERVER=http://eigenda-proxy:3100
EIGENDA_PROXY_STORAGE_BACKENDS_TO_ENABLE=V2
EIGENDA_PROXY_STORAGE_DISPERSAL_BACKEND=V2
# Populated by `make setup` based on NETWORK
EIGENDA_PROXY_EIGENDA_V2_NETWORK=sepolia_testnet # or mainnet
EIGENDA_PROXY_EIGENDA_V2_CERT_VERIFIER_ROUTER_OR_IMMUTABLE_VERIFIER_ADDR=
EIGENDA_PROXY_EIGENDA_V2_DISPERSER_RPC=

# Optional port overrides
RETH_HTTP_PORT=8545
RETH_WS_PORT=8546
RETH_AUTHRPC_PORT=9551
OP_NODE_RPC_PORT=7545
OP_NODE_P2P_PORT=9222
